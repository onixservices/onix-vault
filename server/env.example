# Onix.Vault server — copy to server/.env ON THE SERVER (the .env itself is never committed). The key never travels.
PORT=3004
# RPC with DAS (Helius or equivalent)
ONIX_VAULT_RPC_URL=
# The vault wallet (public key). The reader lists it; deliveries are signed by its key.
VAULT_WALLET=
# Generated on the server: `solana-keygen new -o /opt/onixvault/.vault-key.json` → paste the JSON array here,
# or point a tool at the file. Only server/signer.js reads it.
VAULT_SECRET_KEY=
ONIX_VAULT_DB_PATH=./data/vault.db
ONIX_VAULT_RESERVATION_TTL_MS=600000
ONIX_VAULT_STRIKES_TO_BLOCK=3
ONIX_VAULT_ITEMS_CACHE_MS=30000
# optional: JSON url → { "<mint>": <usd> } market reference per item
ONIX_VAULT_MARKET_REF_URL=
# the curve, once it exists (empty until launch: the page says "not launched")
ONIX_VAULT_POOL=
ONIX_VAULT_BASE_MINT=
ONIX_VAULT_GRADUATION_USD=3500

# the vault graduating itself (server/graduation.js): a full curve is migrated by the server, checked every minute
ONIX_VAULT_GRADUATE=1
