# Onix.Vault server — copy to .env at the repository root ON THE SERVER and run `node --env-file=.env server/index.js`.
# The .env itself is never committed; no key ever travels. Everything the server reads from the environment is listed
# here (server/config.js). A vault listed in ONIX_VAULTS_FILE may name its own key variable (server/registry.js).

PORT=3004
# An RPC with DAS support (Helius or equivalent). SOLANA_RPC_URL is read as a fallback.
ONIX_VAULT_RPC_URL=
# The public origin of this server: token metadata URLs are built from it, never from the Host header.
ONIX_VAULT_PUBLIC_URL=https://vault.onix.finance

# ── the two secrets ───────────────────────────────────────────────────────────────────────────────────────────────
# The master seed every vault's custody wallet derives from (server/keyring.js, SLIP-0010) and the draw key.
# 32 bytes as 64 hex characters, generated ON THE SERVER (`openssl rand -hex 32`), backed up offline, never printed.
VAULT_MASTER_SEED=
# The operator key (Onix, the curve's partner): pays the curve config of every vault and the locker + migration at
# graduation. The 64-byte JSON array `solana-keygen new` writes. Only server/signer.js reads it.
VAULT_SECRET_KEY=

# ── storage ───────────────────────────────────────────────────────────────────────────────────────────────────────
ONIX_VAULT_DB_PATH=./data/vault.db
ONIX_VAULT_UPLOADS_DIR=./data/uploads
# Optional: a JSON file listing vaults the operator runs with its own keys (server/registry.js). Vaults created through
# the page live in the database and need no entry here.
ONIX_VAULTS_FILE=

# ── the loops ─────────────────────────────────────────────────────────────────────────────────────────────────────
# The vault graduating itself (server/graduation.js): a full curve is migrated by the server, checked every minute.
ONIX_VAULT_GRADUATE=0
ONIX_VAULT_GRADUATE_CHECK_MS=60000
# The treasury loop (server/feeclaim.js + server/restock.js), every 15 minutes: claim the trading fees into custody,
# then buy the next item that passes the vault's rules. Off unless set to 1; the scripts work regardless.
ONIX_VAULT_RESTOCK=0
# Every card a vault sells pays its creator 5% and Onix 2% (server/commissions.js), in the same transaction as the fee claim.
# The ledger always keeps the book; the payout legs leave the custody only when this is 1. The first payout is made by hand
# (scripts/payout.js --vault <id> --go --pay, watched on Solscan), then this is turned on.
ONIX_VAULT_SALE_COMMISSION=0
# The venue the treasury buys on.
ONIX_VAULT_CC_API_BASE=https://api.collectorcrypt.com

# ── where Onix is paid (public addresses) ─────────────────────────────────────────────────────────────────────────
# Onix's third of the curve's partner fee and the 2% of every card sold go here, in the same transaction as the vault's
# claim (src/curve/split.js, server/commissions.js). Empty = Onix.Finance's own USDC account, the default written in
# server/config.js. Running this as your own platform: put your account here, or those shares are paid to Onix.
ONIX_VAULT_ONIX_REVENUE_USDC_ACCOUNT=
# Passed as the referral of every swap the page builds: Meteora pays the host share of its own fee to it. Same default.
ONIX_VAULT_REFERRAL_USDC_ACCOUNT=
# Where the page sends people to get USDC.
ONIX_VAULT_SWAP_URL=https://onix.finance

# ── the gacha door and the reader ─────────────────────────────────────────────────────────────────────────────────
ONIX_VAULT_RESERVATION_TTL_MS=600000
ONIX_VAULT_STRIKES_TO_BLOCK=3
ONIX_VAULT_ITEMS_CACHE_MS=30000
# Realisable backing = custodian value × this (the measured median the market pays for the index).
ONIX_VAULT_HAIRCUT=0.89
# Optional: a JSON url → { "<mint>": <usd> } giving a live market reference per item; without it the exit price is the
# custodian's value and the API says so.
ONIX_VAULT_MARKET_REF_URL=
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
ONIX_VAULT_BASE_DECIMALS=6
ONIX_VAULT_QUOTE_DECIMALS=6

# ── single-vault mode (no registry file, no database vaults): one vault from the environment ──────────────────────
# VAULT_WALLET=
# ONIX_VAULT_POOL=
# ONIX_VAULT_BASE_MINT=
# ONIX_VAULT_GRADUATION_USD=

# ── rehearsals (scripts/rehearse-*.js) ────────────────────────────────────────────────────────────────────────────
# ONIX_VAULT_DEVNET_RPC=
