# ─────────────────────────────────────────────────────────────
# ALLOWLIST. Everything is ignored by default and released file
# by file. This repository is PUBLIC: a secret that lands here is
# compromised the moment it leaves this machine. Deleting the
# commit does not fix it; the only correct answer is to ROTATE
# THE KEY. Design rule: if a file needs a secret to work, it is
# on the wrong side of the boundary and does not come in.
# ─────────────────────────────────────────────────────────────
*
!*/

# root
!.gitignore
!README.md
!LICENSE
!package.json
!package-lock.json
!.githooks/pre-commit
!setup.sh
!.gitattributes

# code
!src/**/*.js
!src/**/*.mjs
!src/**/*.json
!web/**/*.html
!web/**/*.css
!web/**/*.js
!web/**/*.svg
!web/**/*.png
!web/**/*.jpg
!web/**/*.ico
!web/**/*.json
!docs/**/*.md
!scripts/**/*.js
!server/**/*.js
!server/openapi.json
!examples/**/*.js
!examples/**/*.md

# configuration examples, never the real file
!*.example
!config.example.json

# never, under any circumstances
.env
.env.*
*.key
*.pem
*keypair*.json
*secret*
node_modules/

# the real configuration and the data never come in (the allowlist above would release them)
config.json
data/
.devnet/
