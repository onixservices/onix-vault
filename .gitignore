# ─────────────────────────────────────────────────────────────
# LISTA BRANCA. Ignora TUDO por omissão e libera ficheiro a ficheiro.
# Este repositório é PÚBLICO: um segredo que chegue aqui está
# comprometido no instante em que sai daqui — apagar o commit não
# resolve, a única resposta correcta é RODAR A CHAVE.
# Regra de desenho: se um ficheiro precisa de um segredo para
# funcionar, está do lado errado da fronteira e não entra.
# ─────────────────────────────────────────────────────────────
*
!*/

# raiz
!.gitignore
!README.md
!LICENSE
!package.json
!package-lock.json
!.githooks/pre-commit
!setup.sh
!.gitattributes

# código
!src/**/*.js
!src/**/*.mjs
!src/**/*.json
!web/**/*.html
!web/**/*.css
!web/**/*.js
!web/**/*.svg
!web/**/*.png
!web/**/*.ico
!web/**/*.json
!docs/**/*.md
!scripts/**/*.js
!server/**/*.js
!server/openapi.json
!examples/**/*.js
!examples/**/*.md

# exemplos de configuração — NUNCA o ficheiro real
!*.example
!config.example.json

# nunca, em circunstância nenhuma
.env
.env.*
*.key
*.pem
*keypair*.json
*secret*
node_modules/
!web/config.example.js

# a config REAL do site nunca entra (a lista branca acima libertava-a)
web/config.js
config.json
data/
.devnet/
