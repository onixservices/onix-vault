#!/usr/bin/env bash
# Safety lock of the PUBLIC onix-vault repository.
# BLOCKS the commit (does not warn) if any staged file smells like a secret.
# Install: bash setup.sh   (sets core.hooksPath=.githooks)
# Emergency, knowing exactly what you are doing: git commit --no-verify

set -uo pipefail
fail=0

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
warn() { printf '\033[33m%s\033[0m\n' "$1"; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# ── 1. files that never come in, by name ───────────────────────────────────
while IFS= read -r f; do
  case "$f" in
    *.env|*.env.*|*.key|*.pem|*keypair*.json|*secret*|*.p12|*.pfx|config.json)
      red "BLOCKED    forbidden file name: $f"; fail=1 ;;
  esac
done <<< "$staged"

# ── 2. content: secret patterns ─────────────────────────────────────────────
# Each entry is "label<TAB>extended regex"
patterns=$(cat <<'PATTERNS'
Solana private key in base58 (~88 chars)	[1-9A-HJ-NP-Za-km-z]{80,}
Solana keypair as JSON (64-byte array)	\[[[:space:]]*([0-9]{1,3}[[:space:]]*,[[:space:]]*){60,}[0-9]{1,3}[[:space:]]*\]
Helius API key in a URL	helius-rpc\.com[^"'"'"' ]*api-key=[A-Za-z0-9-]
secret assigned to a variable	(PRIVATE_KEY|SECRET_KEY|MNEMONIC|SEED_PHRASE|OPERATOR_SECRET)[[:space:]]*[:=]
API key with a value	(api[_-]?key|apikey|access[_-]?token|bearer)[[:space:]]*[:=][[:space:]]*['"'"'"][A-Za-z0-9_-]{16,}
PEM private key block	-----BEGIN[A-Z ]*PRIVATE KEY-----
seed or draw key with a value	(MASTER_SEED|_SEED|DRAW_KEY)[[:space:]]*[:=][[:space:]]*['"'"'"]?[0-9a-fA-F]{32,}
bare 32-byte hex (a seed or a key)	(^|[^0-9A-Za-z])[0-9a-fA-F]{64}([^0-9A-Za-z]|$)
PATTERNS
)

while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in *.example|*.md) continue ;; esac   # examples and docs talk about keys without holding one
  while IFS=$'\t' read -r label rx; do
    [ -z "${rx:-}" ] && continue
    # throwaway test seeds (specification vectors, 0102…) are 32-byte hex by nature
    case "$label" in bare*) case "$f" in *.test.js) continue ;; esac ;; esac
    if git show ":$f" 2>/dev/null | grep -nEq -- "$rx"; then
      red "BLOCKED    $f"
      red "           $label"
      git show ":$f" | grep -nE -- "$rx" | head -3 | cut -c1-110 | sed 's/^/           /'
      fail=1
    fi
  done <<< "$patterns"
done <<< "$staged"

# ── 3. large files (usually a dump or data that should not be here) ────────
while IFS= read -r f; do
  [ -f "$f" ] || continue
  sz=$(wc -c < "$f" 2>/dev/null || echo 0)
  if [ "$sz" -gt 2000000 ]; then
    warn "WARNING    $f is $((sz/1024)) KB; confirm it belongs in a public repository"
  fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
  echo
  red "Commit refused. This repository is PUBLIC."
  red "If any of these secrets has already left this machine, ROTATE THE KEY; deleting the commit is not enough."
  exit 1
fi
exit 0
