#!/usr/bin/env bash
# Trava de segurança do repositório PÚBLICO `vaulty`.
# BLOQUEIA o commit (não avisa) se algum ficheiro em stage tiver cheiro a segredo.
# Instalar: bash setup.sh   (define core.hooksPath=.githooks)
# Emergência, com plena consciência do que está a fazer: git commit --no-verify

set -uo pipefail
fail=0

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
warn() { printf '\033[33m%s\033[0m\n' "$1"; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# ── 1. ficheiros que nunca entram, pelo nome ────────────────────────────────
while IFS= read -r f; do
  case "$f" in
    *.env|*.env.*|*.key|*.pem|*keypair*.json|*secret*|*.p12|*.pfx|web/config.js|config.json)
      red "BLOQUEADO  nome de ficheiro proibido: $f"; fail=1 ;;
  esac
done <<< "$staged"

# ── 2. conteúdo: padrões de segredo ─────────────────────────────────────────
# Cada entrada é "rótulo<TAB>regex estendida"
patterns=$(cat <<'PATTERNS'
chave privada Solana em base58 (~88 chars)	[1-9A-HJ-NP-Za-km-z]{80,}
keypair Solana em JSON (array de 64 bytes)	\[[[:space:]]*([0-9]{1,3}[[:space:]]*,[[:space:]]*){60,}[0-9]{1,3}[[:space:]]*\]
chave de API do Helius no URL	helius-rpc\.com[^"'"'"' ]*api-key=[A-Za-z0-9-]
segredo atribuído a variável	(PRIVATE_KEY|SECRET_KEY|MNEMONIC|SEED_PHRASE|OPERATOR_SECRET)[[:space:]]*[:=]
chave de API com valor	(api[_-]?key|apikey|access[_-]?token|bearer)[[:space:]]*[:=][[:space:]]*['"'"'"][A-Za-z0-9_-]{16,}
bloco de chave privada PEM	-----BEGIN[A-Z ]*PRIVATE KEY-----
PATTERNS
)

while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in *.example|*.md) continue ;; esac   # exemplos e docs falam de chaves sem as ter
  while IFS=$'\t' read -r label rx; do
    [ -z "${rx:-}" ] && continue
    if git show ":$f" 2>/dev/null | grep -nEq -- "$rx"; then
      red "BLOQUEADO  $f"
      red "           $label"
      git show ":$f" | grep -nE -- "$rx" | head -3 | cut -c1-110 | sed 's/^/           /'
      fail=1
    fi
  done <<< "$patterns"
done <<< "$staged"

# ── 3. ficheiros grandes (costuma ser dump/dados que não deviam estar aqui) ──
while IFS= read -r f; do
  [ -f "$f" ] || continue
  sz=$(wc -c < "$f" 2>/dev/null || echo 0)
  if [ "$sz" -gt 2000000 ]; then
    warn "ATENÇÃO    $f tem $((sz/1024)) KB — confirme que é para ir para um repo público"
  fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
  echo
  red "Commit recusado. Este repositório é PÚBLICO."
  red "Se algum destes segredos já saiu da máquina, RODE A CHAVE — não basta apagar o commit."
  exit 1
fi
exit 0
